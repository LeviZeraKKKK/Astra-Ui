-- Arrastar sem teleporte
local dragStartPos, startMousePos

local function setupDragging(element)
    element.InputBegan:Connect(function(input)
        if (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) and not resizing then
            dragging = true
            startMousePos = input.Position
            dragStartPos = MainFrame.Position
            
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)
end

setupDragging(TopBar)
setupDragging(BottomBar)

UserInputService.InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - startMousePos
        MainFrame.Position = UDim2.new(
            dragStartPos.X.Scale, 
            dragStartPos.X.Offset + delta.X, 
            dragStartPos.Y.Scale, 
            dragStartPos.Y.Offset + delta.Y
        )
    end
end)

