--------------------------------------------------------------------------------
-- LÓGICA DE BOOST INFINITO (ZERO LAG)
--------------------------------------------------------------------------------
local boostInfiniteEnabled = false
local VALOR_BOOST = 100
local RESCAN_COOLDOWN = 10
local cacheBoost, cacheBoostCount = {}, 0
local lastRescanBoost = 0

local function compactAndApplyBoost()
    local v = VALOR_BOOST
    local n = 0
    for i = 1, cacheBoostCount do
        local obj = cacheBoost[i]
        if type(obj) == "table" and rawget(obj, "boost") then
            if boostInfiniteEnabled then
                obj.boost = v
            end
            n = n + 1
            cacheBoost[n] = obj
        end
    end
    for i = n + 1, cacheBoostCount do cacheBoost[i] = nil end
    cacheBoostCount = n
end

local function rescanBoost()
    local v = VALOR_BOOST
    local n = 0
    for _, obj in pairs(getgc(true)) do
        if type(obj) == "table" and rawget(obj, "boost") and rawget(obj, "boostUsedPerSecond") then
            if boostInfiniteEnabled then
                obj.boost = v
            end
            n = n + 1
            cacheBoost[n] = obj
        end
    end
    cacheBoostCount = n
    lastRescanBoost = tick()
end

RunService.Heartbeat:Connect(function()
    if not boostInfiniteEnabled then return end
    if cacheBoostCount == 0 then
        if tick() - lastRescanBoost >= RESCAN_COOLDOWN then
            task.defer(rescanBoost)
        end
        return
    end
    compactAndApplyBoost()
end)

