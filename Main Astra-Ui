--------------------------------------------------------------------------------
-- LÓGICA DE FORÇA E PULOS INFINITOS (TURBO SOCCER)
--------------------------------------------------------------------------------
local jumpModEnabled = false
local infiniteJumpsOn = false

local MULT_GROUND  = 1
local MULT_DBL     = 1
local MULT_FLIP    = 1
local MULT_DODGE   = 1

local constRef = nil
local constOriginals = nil
local lastRescanConst = 0

local function captureConstOriginals(c)
    constOriginals = {
        JUMP_IMMEDIATE_FORCE = c.JUMP_IMMEDIATE_FORCE,
        JUMP_ACCEL           = c.JUMP_ACCEL,
        FLIP_FORWARD_IMPULSE_MAX_SPEED_SCALE  = c.FLIP_FORWARD_IMPULSE_MAX_SPEED_SCALE,
        FLIP_BACKWARD_IMPULSE_MAX_SPEED_SCALE = c.FLIP_BACKWARD_IMPULSE_MAX_SPEED_SCALE,
        FLIP_TORQUE_X = c.FLIP_TORQUE_X,
        FLIP_SIDE_IMPULSE_MAX_SPEED_SCALE = c.FLIP_SIDE_IMPULSE_MAX_SPEED_SCALE,
        FLIP_TORQUE_Y = c.FLIP_TORQUE_Y,
    }
end

local function applyConstMult()
    if not constRef or not constOriginals then return end
    local c = constRef
    local o = constOriginals

    local mg = jumpModEnabled and MULT_GROUND or 1
    local mf = jumpModEnabled and MULT_FLIP or 1
    local md = jumpModEnabled and MULT_DODGE or 1

    c.JUMP_IMMEDIATE_FORCE = o.JUMP_IMMEDIATE_FORCE * mg
    c.JUMP_ACCEL           = o.JUMP_ACCEL           * mg

    c.FLIP_FORWARD_IMPULSE_MAX_SPEED_SCALE  = o.FLIP_FORWARD_IMPULSE_MAX_SPEED_SCALE  * mf
    c.FLIP_BACKWARD_IMPULSE_MAX_SPEED_SCALE = o.FLIP_BACKWARD_IMPULSE_MAX_SPEED_SCALE * mf
    c.FLIP_TORQUE_X = o.FLIP_TORQUE_X * mf

    c.FLIP_SIDE_IMPULSE_MAX_SPEED_SCALE = o.FLIP_SIDE_IMPULSE_MAX_SPEED_SCALE * md
    c.FLIP_TORQUE_Y = o.FLIP_TORQUE_Y * md
end

local function rescanConst()
    for _, obj in pairs(getgc(true)) do
        if type(obj) == "table"
           and rawget(obj, "JUMP_IMMEDIATE_FORCE") ~= nil
           and rawget(obj, "FLIP_INITIAL_VEL_SCALE") ~= nil
           and rawget(obj, "FLIP_FORWARD_IMPULSE_MAX_SPEED_SCALE") ~= nil then
            constRef = obj
            if not constOriginals then
                captureConstOriginals(obj)
            end
            applyConstMult()
            break
        end
    end
    lastRescanConst = tick()
end

local carCache = setmetatable({}, {__mode = "v"})
local carCount = 0
local lastRescanCar = 0

local function isCar(obj)
    return type(obj) == "table"
        and rawget(obj, "hasJumped")       ~= nil
        and rawget(obj, "hasDoubleJumped") ~= nil
        and rawget(obj, "hasFlipped")      ~= nil
        and rawget(obj, "isOnGround")      ~= nil
end

local function installDoubleJumpHook(car)
    if car._jpHooked then return end
    local mt = getmetatable(car)
    if type(mt) ~= "table" then return end

    local origV3 = mt._updateDoubleJumpOrFlipV3
    local origClassic = mt._updateDoubleJumpOrFlip
    if type(origV3) ~= "function" and type(origClassic) ~= "function" then return end

    car._jpHooked = true

    local function wrap(orig)
        return function(self, a, b, c)
            if constRef and constOriginals and jumpModEnabled and MULT_DBL ~= 1 then
                local saved = constRef.JUMP_IMMEDIATE_FORCE
                constRef.JUMP_IMMEDIATE_FORCE = constOriginals.JUMP_IMMEDIATE_FORCE * MULT_DBL
                local r = orig(self, a, b, c)
                constRef.JUMP_IMMEDIATE_FORCE = saved
                return r
            end
            return orig(self, a, b, c)
        end
    end

    if type(origV3) == "function" then
        car._updateDoubleJumpOrFlipV3 = wrap(origV3)
    end
    if type(origClassic) == "function" then
        car._updateDoubleJumpOrFlip = wrap(origClassic)
    end
end

local function rescanCars()
    carCount = 0
    for _, obj in pairs(getgc(true)) do
        if isCar(obj) then
            installDoubleJumpHook(obj)
            carCount = carCount + 1
            carCache[carCount] = obj
        end
    end
    lastRescanCar = tick()
end

local function compactCars()
    local n = 0
    for i = 1, carCount do
        local obj = carCache[i]
        if isCar(obj) then
            installDoubleJumpHook(obj)
            n = n + 1
            carCache[n] = obj
        end
    end
    for i = n + 1, carCount do carCache[i] = nil end
    carCount = n
end

RunService.Heartbeat:Connect(function()
    if not constRef or not constOriginals then
        if tick() - lastRescanConst >= 8 then
            task.defer(rescanConst)
        end
    else
        applyConstMult()
    end

    if infiniteJumpsOn or jumpModEnabled then
        if carCount == 0 then
            if tick() - lastRescanCar >= 3 then
                task.defer(rescanCars)
            end
        else
            compactCars()
            if infiniteJumpsOn then
                for i = 1, carCount do
                    local car = carCache[i]
                    if car then
                        if car.isOnGround then
                            car.hasJumped         = false
                            car.jumpTime          = 0
                            car.hasDoubleJumped   = false
                            car.hasFlipped        = false
                            car.airTime           = 0
                            car.airTimeSinceJump  = 0
                            car.flipTime          = 0
                        else
                            car.hasDoubleJumped   = false
                            car.airTimeSinceJump  = 0
                            if not car.isFlipping then
                                car.hasFlipped = false
                                car.flipTime   = 0
                            end
                        end
                    end
                end
            end
        end
    end
end)

task.defer(rescanConst)
task.defer(rescanCars)

