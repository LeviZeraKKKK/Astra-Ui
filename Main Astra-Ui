-- LÓGICA DE FORÇA DO BOOST (ZERO LAG)
--------------------------------------------------------------------------------
local boostForceEnabled = false
local MULT_BOOST_FORCE = 1
local BASE_BOOST_FORCE = 4000
local cacheBoostForce, cacheBoostForceCount = {}, 0
local lastRescanBoostForce = 0

local function compactAndApplyBoostForce()
    local f = boostForceEnabled and (BASE_BOOST_FORCE * MULT_BOOST_FORCE) or 1000
    local n = 0
    for i = 1, cacheBoostForceCount do
        local obj = cacheBoostForce[i]
        if type(obj) == "table" and rawget(obj, "BOOST_ACCEL_GROUND") then
            obj.BOOST_ACCEL_GROUND = f
            obj.BOOST_ACCEL_AIR    = f
            n = n + 1
            cacheBoostForce[n] = obj
        end
    end
    for i = n + 1, cacheBoostForceCount do cacheBoostForce[i] = nil end
    cacheBoostForceCount = n
end

local function rescanBoostForce()
    local f = boostForceEnabled and (BASE_BOOST_FORCE * MULT_BOOST_FORCE) or 1000
    local n = 0
    for _, obj in pairs(getgc(true)) do
        if type(obj) == "table" and rawget(obj, "BOOST_ACCEL_GROUND") then
            obj.BOOST_ACCEL_GROUND = f
            obj.BOOST_ACCEL_AIR    = f
            n = n + 1
            cacheBoostForce[n] = obj
        end
    end
    cacheBoostForceCount = n
    lastRescanBoostForce = tick()
end

local function setBoostForceMultiplier(mult)
    MULT_BOOST_FORCE = mult
    if boostForceEnabled then
        if cacheBoostForceCount > 0 then
            compactAndApplyBoostForce()
        else
            task.defer(rescanBoostForce)
        end
    end
end

RunService.Heartbeat:Connect(function()
    if not boostForceEnabled then return end
    if cacheBoostForceCount == 0 then
        if tick() - lastRescanBoostForce >= RESCAN_COOLDOWN then
            task.defer(rescanBoostForce)
